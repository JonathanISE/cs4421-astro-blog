---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import captainHeadshot from '../assets/captain-headshot.svg';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { summariseLog } from '../utils/logStats';

const captain = await getEntry('authors', 'jonathan-murphy');
const github = captain?.data.socialLinks.find((link) => link.label === 'GitHub');
if (!captain || !github) {
	throw new Error('The About page needs the jonathan-murphy author entry with a GitHub link.');
}
const githubUsername = new URL(github.url).pathname.replace(/^\/|\/$/g, '');

const logStats = summariseLog((await getCollection('books')).map((book) => book.data.readScore));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`About the Captain | ${SITE_TITLE}`}
			description={`Meet ${captain.data.name}, the captain keeping this log.`}
		/>
		<style>
			:global(body) {
				background:
					radial-gradient(circle at 50% 0, rgba(255, 248, 232, 0.7), transparent 40rem),
					#e8d4b8;
			}
			main {
				width: min(100% - 2rem, 700px);
				box-sizing: border-box;
				margin: 0 auto;
				padding: clamp(3rem, 8vw, 6rem) 0 clamp(4rem, 10vw, 7rem);
				color: #3c2a20;
				font-family: Georgia, 'Times New Roman', serif;
			}
			.quarters {
				display: grid;
				justify-items: center;
				gap: 1.5rem;
				text-align: center;
			}
			.captain {
				width: clamp(8.5rem, 40vw, 11.5rem);
				height: auto;
			}
			h1 {
				margin: 0 0 0.75rem;
				color: #3e241b;
				font-family: Cinzel, 'Trajan Pro', Georgia, serif;
				font-size: clamp(2.2rem, 6vw, 3.6rem);
				font-variant: small-caps;
				line-height: 1.1;
			}
			.welcome {
				margin: 0;
				color: #73584c;
				font-size: clamp(1.05rem, 2.2vw, 1.25rem);
			}
			.log-stats {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.4rem 0.9rem;
				margin: 1.5rem 0 0;
				padding: 0;
				color: #70452c;
				font-size: 0.95rem;
				font-weight: 700;
				list-style: none;
			}
			.log-stats li + li::before {
				margin-right: 0.9rem;
				color: #bd8a35;
				content: '·';
			}
			.github {
				display: inline-flex;
				flex-direction: column;
				align-items: center;
				margin-top: 1.75rem;
				padding: 0.7rem 1.4rem;
				border: 1px solid #9d7432;
				border-radius: 0.25rem;
				background: linear-gradient(180deg, #87652f, #4b351d);
				color: #f7dfaa;
				text-decoration: none;
				text-shadow: 0 1px #38220f;
				transition: filter 0.2s ease, border-color 0.2s ease;
			}
			.github:hover,
			.github:focus-visible {
				border-color: #f5d47f;
				filter: brightness(1.15);
			}
			.github-label {
				font-size: 1.05rem;
				font-weight: 700;
			}
			.github-username {
				color: #e8c36d;
				font-size: 0.85rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="quarters" aria-labelledby="about-title">
				<Image
					class="captain"
					src={captainHeadshot}
					alt="Silhouette profile image of a ship's captain in a tricorn hat and coat."
				/>
				<div>
					<h1 id="about-title">The captain's quarters</h1>
					<p class="welcome">{captain.data.name}, keeping this log from Ireland.</p>
					<ul class="log-stats" aria-label="Log statistics">
						{logStats.map((stat) => <li>{stat}</li>)}
					</ul>
					<a class="github" href={github.url}>
						<span class="github-label">Find me on GitHub</span>
						<span class="github-username">@{githubUsername}</span>
					</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
