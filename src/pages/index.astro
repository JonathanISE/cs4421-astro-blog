---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Bookcase from '../components/Bookcase.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const books = (await getCollection('books')).sort(
	(first, second) => first.data.reviewDate.getTime() - second.data.reviewDate.getTime(),
);
const genres = ['Fiction', 'Non-Fiction', 'Fantasy'] as const;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: min(100% - 2rem, 1180px);
				box-sizing: border-box;
				margin: 0 auto;
				padding: clamp(3.5rem, 8vw, 7rem) 0 clamp(5rem, 10vw, 9rem);
			}
			:global(body) {
				background:
					radial-gradient(circle at 50% 0, rgba(255, 248, 232, 0.7), transparent 40rem),
					#e8d4b8;
			}
			.intro {
				max-width: 620px;
				margin: 0 auto 3.5rem;
				text-align: center;
			}
			.eyebrow {
				margin: 0 0 0.75rem;
				color: #28533d;
				font-size: 0.78rem;
				font-weight: 700;
				letter-spacing: 0.18em;
				text-transform: uppercase;
			}
			.intro h1 {
				margin-bottom: 1rem;
				color: #3e241b;
				font-family: Cinzel, 'Trajan Pro', Georgia, 'Times New Roman', serif;
				font-size: clamp(2.5rem, 7vw, 4.8rem);
				font-variant: small-caps;
				letter-spacing: -0.045em;
			}
			.intro p {
				margin: 0;
				color: #73584c;
				font-size: clamp(1rem, 2vw, 1.15rem);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="intro" aria-labelledby="page-title">
				<p class="eyebrow">A well-kept captain's log</p>
				<h1 id="page-title">The captain's cabin</h1>
				<p>Stories, ideas, and discoveries charted for the next voyage.</p>
			</section>
			<Bookcase books={books} genres={genres} />
		</main>
		<Footer />
	</body>
</html>
