---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const reviews = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const books = await Promise.all(
	reviews.map(async (review) => {
		const author = await getEntry('authors', review.data.author);

		return {
			...review,
			authorName: author?.data.name ?? review.data.author,
		};
	}),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 100%;
				max-width: 1120px;
				box-sizing: border-box;
				padding: 5rem 2rem 6rem;
			}
			.hero {
				max-width: 680px;
				margin-bottom: 4rem;
			}
			.eyebrow {
				margin: 0 0 0.75rem;
				color: var(--accent-dark);
				font-size: 0.8rem;
				font-weight: 700;
				letter-spacing: 0.16em;
				text-transform: uppercase;
			}
			.hero h1 {
				margin-bottom: 1rem;
				font-size: clamp(2.5rem, 7vw, 4.8rem);
				letter-spacing: -0.04em;
			}
			.hero p {
				max-width: 580px;
				margin: 0;
				color: rgb(var(--gray));
				font-size: 1.1rem;
			}
			.shelf {
				position: relative;
				padding: 3.25rem 2.75rem 3.5rem;
				border: 0.7rem solid #744625;
				border-radius: 18px 18px 8px 8px;
				background:
					linear-gradient(90deg, rgba(92, 52, 27, 0.6), transparent 1.4rem, transparent calc(100% - 1.4rem), rgba(92, 52, 27, 0.6)),
					repeating-linear-gradient(
						0deg,
						#ead7bd 0,
						#f5e7d3 4px,
						#e1c6a5 8px,
						#f5e7d3 13px
					);
				box-shadow:
					inset 0 0 0 0.25rem #b47b4b,
					inset 1.2rem 0 0 rgba(102, 57, 29, 0.18),
					inset -1.2rem 0 0 rgba(102, 57, 29, 0.18),
					0 16px 30px rgba(79, 50, 28, 0.18);
			}
			.shelf::before {
				position: absolute;
				top: -1.15rem;
				right: -1.1rem;
				left: -1.1rem;
				z-index: 2;
				height: 1.35rem;
				border: 1px solid #744625;
				border-radius: 5px 5px 3px 3px;
				background:
					linear-gradient(to bottom, rgba(255, 223, 172, 0.55), transparent 0.28rem),
					repeating-linear-gradient(
						88deg,
						#a96d3c 0,
						#b97945 3px,
						#955b32 6px,
						#aa6b3b 11px
					);
				box-shadow: 0 0.35rem 0 #744625, 0 0.6rem 0.8rem rgba(79, 50, 28, 0.2);
				content: '';
			}
			.shelf::after {
				position: absolute;
				right: -0.9rem;
				bottom: -1rem;
				left: -0.9rem;
				z-index: 2;
				height: 1.35rem;
				border: 1px solid #744625;
				border-radius: 3px 3px 8px 8px;
				background: repeating-linear-gradient(
					88deg,
					#a96d3c 0,
					#b97945 3px,
					#955b32 6px,
					#aa6b3b 11px
				);
				box-shadow: 0 0.4rem 0 #5f381f, 0 0.75rem 1rem rgba(79, 50, 28, 0.2);
				content: '';
			}
			.shelf-heading {
				position: relative;
				z-index: 3;
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1rem;
				margin-bottom: 2rem;
			}
			.shelf-heading h2 {
				margin: 0;
				font-size: clamp(1.5rem, 3vw, 2rem);
			}
			.review-count {
				margin: 0;
				color: #744625;
				font-size: 0.9rem;
				font-weight: 700;
			}
			.book-list {
				position: relative;
				z-index: 3;
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
				align-items: end;
				gap: 2rem 1.5rem;
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.book {
				position: relative;
				height: 100%;
				padding-bottom: 1.7rem;
			}
			.book::after {
				position: absolute;
				right: -0.75rem;
				bottom: 0;
				left: -0.75rem;
				height: 1.05rem;
				border: 1px solid #744625;
				border-radius: 3px 3px 7px 7px;
				background:
					linear-gradient(to bottom, rgba(255, 224, 174, 0.55) 0 0.18rem, transparent 0.18rem),
					repeating-linear-gradient(
						88deg,
						#a96d3c 0,
						#b97945 2px,
						#955b32 4px,
						#aa6b3b 7px
					);
				box-shadow:
					0 0.25rem 0 #744625,
					0 0.45rem 0.7rem rgba(79, 50, 28, 0.22);
				content: '';
			}
			.book::before {
				position: absolute;
				right: -0.5rem;
				bottom: 0.8rem;
				left: -0.5rem;
				z-index: 0;
				height: 0.3rem;
				border-radius: 50%;
				background: rgba(255, 220, 167, 0.6);
				content: '';
			}
			.book a {
				display: block;
				height: 100%;
				position: relative;
				z-index: 1;
				color: inherit;
				text-decoration: none;
				transition: transform 0.2s ease;
			}
			.book a:hover,
			.book a:focus-visible {
				transform: translateY(-0.5rem);
			}
			.book-cover {
				position: relative;
				display: flex;
				aspect-ratio: 3 / 4;
				align-items: center;
				justify-content: center;
				overflow: hidden;
				margin-bottom: 1rem;
				border: 0.5rem solid #fffaf1;
				border-radius: 4px 10px 10px 4px;
				background: #fffaf1;
				box-shadow: 0.5rem 0.5rem 0 rgba(87, 50, 22, 0.2), inset 0 0 0 1px rgba(0, 0, 0, 0.08);
			}
			.book-cover::before {
				position: absolute;
				top: 0;
				bottom: 0;
				left: 0;
				z-index: 1;
				width: 0.35rem;
				background: rgba(255, 255, 255, 0.6);
				content: '';
			}
			.book-cover img {
				width: 100%;
				height: 100%;
				border-radius: 0;
				object-fit: cover;
			}
			.cover-placeholder {
				padding: 1rem;
				color: var(--accent-dark);
				font-size: 1.15rem;
				font-weight: 700;
				line-height: 1.2;
				text-align: center;
			}
			.book h3 {
				margin: 0 0 0.2rem;
				font-size: 1.15rem;
			}
			.book-author {
				margin: 0;
				color: rgb(var(--gray-dark));
				font-size: 0.95rem;
			}
			.book a:hover h3,
			.book a:focus-visible h3 {
				color: var(--accent-dark);
			}
			@media (max-width: 600px) {
				main {
					padding: 3rem 1rem 4rem;
				}
				.hero {
					margin-bottom: 2.5rem;
				}
				.shelf {
					padding: 3rem 1.5rem 3.25rem;
					border-width: 0.5rem;
				}
				.shelf::before {
					right: -0.7rem;
					left: -0.7rem;
				}
				.shelf::after {
					right: -0.6rem;
					left: -0.6rem;
				}
				.book-list {
					grid-template-columns: repeat(2, minmax(0, 1fr));
					gap: 1.75rem 1rem;
				}
				.book::after {
					right: -0.5rem;
					left: -0.5rem;
				}
				.book::before {
					right: -0.25rem;
					left: -0.25rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero" aria-labelledby="page-title">
				<p class="eyebrow">A collection of thoughtful reads</p>
				<h1 id="page-title">Find your next great read.</h1>
				<p>Browse our latest book reviews, pick a title from the shelf, and settle in for a closer look.</p>
			</section>

			<section class="shelf" aria-labelledby="shelf-title">
				<div class="shelf-heading">
					<h2 id="shelf-title">Reviews on the shelf</h2>
					<p class="review-count">{books.length} {books.length === 1 ? 'review' : 'reviews'}</p>
				</div>
				<ul class="book-list">
					{
						books.map((book) => (
							<li class="book">
								<a href={`/blog/${book.id}/`} aria-label={`Read the review of ${book.data.title}`}>
									<div class="book-cover">
										{book.data.heroImage ? (
											<Image src={book.data.heroImage} alt="" />
										) : (
											<span class="cover-placeholder">{book.data.title}</span>
										)}
									</div>
									<h3>{book.data.title}</h3>
									<p class="book-author">by {book.authorName}</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
