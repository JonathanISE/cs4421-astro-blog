---
import { type CollectionEntry, getCollection } from 'astro:content';
import BookReview from '../../layouts/BookReview.astro';
import { getBookCover } from '../../utils/googleBooks';

export async function getStaticPaths() {
	const reviews = await getCollection('books');
	const paths = [];
	for (const review of reviews) {
		const coverUrl = await getBookCover(review.data);
		paths.push({
			params: { slug: review.id },
			props: {
				review,
				coverUrl,
			},
		});
	}
	return paths;
}

type Props = {
	review: CollectionEntry<'books'>;
	coverUrl?: string;
};
const { review, coverUrl } = Astro.props as Props;
---

<BookReview {...review.data} googleCover={coverUrl} />
