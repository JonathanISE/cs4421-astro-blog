---
import { type CollectionEntry, getCollection } from 'astro:content';
import BookReview from '../../layouts/BookReview.astro';
import { findGoogleBooksCover } from '../../utils/googleBooks';

export async function getStaticPaths() {
	const reviews = await getCollection('books');
	const paths = [];
	for (const review of reviews) {
		const googleCover = review.data.cover ? undefined : await findGoogleBooksCover(review.data);
		if (review.data.cover) {
			console.warn(`[book cover] title="${review.data.title}" ISBN="${review.data.isbn ?? '(none)'}" source=manual`);
		}
		paths.push({
			params: { slug: review.id },
			props: {
				review,
				googleCover,
			},
		});
	}
	return paths;
}

type Props = {
	review: CollectionEntry<'books'>;
	googleCover?: string;
};
const { review, googleCover } = Astro.props as Props;
---

<BookReview {...review.data} googleCover={googleCover} />
