---
const today = new Date();
---

<footer>
	<div class="lantern" aria-hidden="true">✦</div>
	<p class="signoff">Fair winds and following seas</p>
	<p class="copyright">&copy; {today.getFullYear()} Captain's Log. All rights reserved.</p>
</footer>

<style>
	footer {
		position: relative;
		padding: 2.8rem 1rem 3.5rem;
		overflow: hidden;
		background:
			radial-gradient(circle at 50% 0, rgba(235, 177, 69, 0.2), transparent 8rem),
			repeating-linear-gradient(0deg, rgba(255, 221, 145, 0.04) 0 1px, transparent 1px 0.75rem),
			linear-gradient(180deg, #2c1a12, #160c09);
		border-top: 4px solid #b98635;
		color: #ead3a0;
		text-align: center;
	}
	footer::before {
		position: absolute;
		top: -0.45rem;
		right: 0;
		left: 0;
		height: 0.35rem;
		background: repeating-linear-gradient(135deg, #caa154 0 0.45rem, #6e4b24 0.45rem 0.9rem);
		content: '';
	}
	.lantern {
		display: grid;
		width: 2.4rem;
		height: 2.4rem;
		place-items: center;
		margin: 0 auto 0.8rem;
		border: 2px solid #c99a43;
		border-radius: 45% 45% 50% 50%;
		background: #8d5a1b;
		color: #ffe39a;
		box-shadow: 0 0 1.8rem rgba(236, 170, 54, 0.65), inset 0 0 0.7rem #ffe5a2;
		animation: lantern-glow 4s ease-in-out infinite;
	}
	.signoff {
		margin: 0;
		color: #f0cf82;
		font-family: Cinzel, 'Trajan Pro', Georgia, serif;
		font-size: 1.05rem;
		font-style: italic;
	}
	.copyright {
		margin: 0.8rem 0 0;
		color: #bda77c;
		font-size: 0.8rem;
	}
	@keyframes lantern-glow {
		50% { box-shadow: 0 0 2.2rem rgba(236, 170, 54, 0.8), inset 0 0 0.7rem #ffe5a2; }
	}
	@media (prefers-reduced-motion: reduce) {
		.lantern { animation: none; }
	}
</style>
