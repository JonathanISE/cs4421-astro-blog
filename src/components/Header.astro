---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav aria-label="Main navigation">
		<a class="brand" href="/" aria-label="Captain's Log home">
			<span class="ship-wheel" aria-hidden="true">✦</span>
			<span>{SITE_TITLE}</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">Cabin</HeaderLink>
			<HeaderLink href="/blog">Logbook</HeaderLink>
			<HeaderLink href="/about">About the Captain</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		position: relative;
		padding: 0.8rem 1rem;
		background:
			repeating-linear-gradient(0deg, rgba(255, 221, 145, 0.04) 0 1px, transparent 1px 0.75rem),
			linear-gradient(180deg, #3a2419, #21130e);
		border-bottom: 3px solid #bd8a35;
		box-shadow: 0 0.35rem 1.2rem rgba(38, 18, 8, 0.35);
	}
	header::after {
		position: absolute;
		right: 0;
		bottom: -0.45rem;
		left: 0;
		height: 0.3rem;
		background: repeating-linear-gradient(135deg, #caa154 0 0.45rem, #6e4b24 0.45rem 0.9rem);
		content: '';
	}
	nav {
		display: flex;
		max-width: 1180px;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin: 0 auto;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		color: #f0d28c;
		font-family: Cinzel, 'Trajan Pro', Georgia, serif;
		font-size: clamp(1rem, 2.5vw, 1.35rem);
		font-weight: 700;
		letter-spacing: 0.08em;
		text-decoration: none;
		text-transform: uppercase;
	}
	.ship-wheel {
		display: grid;
		width: 2.15rem;
		height: 2.15rem;
		place-items: center;
		border: 2px solid #d2a64c;
		border-radius: 50%;
		color: #e8c36d;
		font-size: 1.3rem;
		box-shadow: inset 0 0 0 0.22rem #5a3c20, 0 0 0 1px #6e4b24;
		transform: rotate(45deg);
	}
	.internal-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.45rem;
	}
	nav a:not(.brand) {
		padding: 0.4rem 0.75rem;
		border: 1px solid #9d7432;
		border-radius: 0.18rem;
		background: linear-gradient(180deg, #87652f, #4b351d);
		color: #f7dfaa;
		font-family: Georgia, serif;
		font-size: 0.82rem;
		text-decoration: none;
		text-shadow: 0 1px #38220f;
		transition: color 0.2s ease, border-color 0.2s ease, filter 0.2s ease;
	}
	nav a:not(.brand):hover,
	nav a:not(.brand):focus-visible {
		border-color: #f5d47f;
		color: #fff3cc;
		filter: brightness(1.15);
	}
	@media (max-width: 650px) {
		nav { align-items: flex-start; flex-direction: column; }
		.internal-links { justify-content: flex-start; }
		nav a:not(.brand) { padding: 0.35rem 0.55rem; font-size: 0.76rem; }
	}
</style>
